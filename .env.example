# LLM Provider Configuration (gemini | groq | ollama | stub)
LLM_PROVIDER=stub

# Stub LLM Configuration
STUB_LLM_URL=http://stub_llm:8001
STUB_DELAY_SECONDS=0.1

# Provider Credentials & Models (Injected at runtime only - no keys committed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Redis & Job Queue Configuration
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=export_classification_jobs

# API & Worker Configuration
API_HOST=0.0.0.0
API_PORT=8000
WORKER_CONCURRENCY=1

# Corpus & Retrieval Paths
CORPUS_DIR=data/sample
INDEX_DIR=data/index
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Observability
QUARANTINE_DB_PATH=data/quarantine.db
TRACE_DB_PATH=data/traces.db
LOG_LEVEL=INFO

# Reliability & Circuit Breaker
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_SEC=30
LLM_REQUEST_TIMEOUT_SEC=60
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
TOOL_CALL_TIMEOUT_SEC=10

# Agent Bounds
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_WALL_CLOCK_TIMEOUT_SEC=120
CLASSIFIER_PROMPT_VERSION=classifier_v3
PROMPT_VERSION=classifier_v3

# Token Cost Rates (USD per token, default 0.0)
COST_PER_PROMPT_TOKEN=0.0
COST_PER_COMPLETION_TOKEN=0.0

